# ============================================================================
# ShadowHound Secrets (API Keys and Credentials)
# ============================================================================
#
# This file contains sensitive API keys and credentials.
# Copy to .env.secrets and fill in your actual keys.
#
# NEVER commit this file to git!
#
# Usage:
#   1. Copy: cp .env.secrets.example .env.secrets
#   2. Edit .env.secrets with your actual keys
#   3. Source in your environment or let start.sh load it
#
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI API Key
# ----------------------------------------------------------------------------

# Get from: https://platform.openai.com/api-keys
# Required for: OpenAI backend (GPT-4, GPT-3.5, etc.)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ----------------------------------------------------------------------------
# Anthropic API Key (Optional)
# ----------------------------------------------------------------------------

# Get from: https://console.anthropic.com/
# Required for: Claude backend (if using Anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ----------------------------------------------------------------------------
# Other API Keys (Optional)
# ----------------------------------------------------------------------------

# Add other sensitive keys here as needed
# Examples:
# HUGGINGFACE_TOKEN=hf_your_token_here
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============================================================================
# Security Notes
# ============================================================================
#
# - This file is gitignored (.env.secrets in .gitignore)
# - Never share these keys publicly
# - Rotate keys if compromised
# - Use different keys for dev/staging/production
# - Consider using environment variables in CI/CD instead
#
# ============================================================================
