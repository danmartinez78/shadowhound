# ============================================================================
# ShadowHound Simulation Environment (Isaac Sim on Tower)
# ============================================================================
#
# Configuration for testing with Isaac Sim running on Tower.
# Laptop runs mission agent, Tower runs simulation.
#
# Copy to .env when testing with simulation:
#   cp .env.simulation .env
#
# API Keys: Create .env.secrets with your keys (see .env.secrets.example)
#
# ============================================================================

# ----------------------------------------------------------------------------
# Core Configuration
# ----------------------------------------------------------------------------

# API Keys loaded from .env.secrets (gitignored)
# Create: cp .env.secrets.example .env.secrets
# Then edit .env.secrets with your actual OPENAI_API_KEY

# Environment
ENVIRONMENT=simulation

# ----------------------------------------------------------------------------
# Robot Configuration - SIMULATION MODE
# ----------------------------------------------------------------------------

# Use simulation mode (Isaac Sim on Tower)
ROBOT_MODE=simulation

# Robot IP (not used in simulation mode - sim publishes topics directly)
ROBOT_IP=192.168.10.116

# ----------------------------------------------------------------------------
# ROS2 Configuration - CRITICAL FOR SIMULATION
# ----------------------------------------------------------------------------

# Use domain ID 0 (matches Tower sim)
ROS_DOMAIN_ID=0

# Allow cross-machine communication (REQUIRED for laptop-Tower setup)
ROS_LOCALHOST_ONLY=0

# Use CycloneDDS for better performance
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# CycloneDDS configuration for network reliability with large messages
CYCLONEDDS_URI=file://${PWD}/config/cyclonedds_network.xml

# Connection type MUST be cyclonedds for sim
# WebRTC not available in simulation mode
CONN_TYPE=cyclonedds

# Verbose logging for development
RCUTILS_LOGGING_LEVEL=INFO

# ----------------------------------------------------------------------------
# Agent Configuration - OPENAI CLOUD
# ----------------------------------------------------------------------------

# Use OpenAI cloud backend (recommended for sim testing)
AGENT_BACKEND=openai

# OpenAI Settings
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# Use basic agent (faster for testing)
USE_PLANNING_AGENT=false

# Use cloud embeddings for sim testing
USE_LOCAL_EMBEDDINGS=false

# More permissive RAG settings
RAG_QUERY_N=3
RAG_SIMILARITY_THRESHOLD=0.4

# ----------------------------------------------------------------------------
# Web Interface - ENABLED
# ----------------------------------------------------------------------------

# Enable web dashboard for easy testing
ENABLE_WEB_INTERFACE=true

# Standard port
WEB_PORT=8080

# Bind to all interfaces (access from Tower if needed)
WEB_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Logging - VERBOSE
# ----------------------------------------------------------------------------

# Enable debug logging
LOG_LEVEL=INFO
DIMOS_DEBUG=false

# Save all outputs
AGENT_OUTPUT_DIR=./sim_output

# ----------------------------------------------------------------------------
# Development Helpers
# ----------------------------------------------------------------------------

# Test mode
TEST_MODE=false

# Process all inputs
PROCESS_ALL_INPUTS=true

# ----------------------------------------------------------------------------
# Simulation Setup Instructions
# ----------------------------------------------------------------------------
#
# Prerequisites:
#   1. Tower running Isaac Sim with go2_omniverse
#   2. Laptop and Tower on same network
#   3. ROS_DOMAIN_ID=0 on both machines
#   4. ROS_LOCALHOST_ONLY=0 on both machines
#
# Quick Start:
#   1. On Tower: Start Isaac Sim
#      cd ~/workspace/go2_omniverse
#      ./run_sim.sh
#
#   2. On Laptop: Verify topics visible
#      export ROS_DOMAIN_ID=0
#      export ROS_LOCALHOST_ONLY=0
#      source /opt/ros/humble/setup.bash
#      ros2 topic list | grep robot0
#      # Should see: /robot0/cmd_vel, /robot0/odom, etc.
#
#   3. On Laptop: Copy this config
#      cp .env.simulation .env
#      # Edit OPENAI_API_KEY above!
#
#   4. On Laptop: Launch mission agent
#      ./start.sh
#      # OR manually:
#      cd ~/shadowhound
#      source install/setup.bash
#      ros2 launch shadowhound_mission_agent mission_agent.launch.py \
#          robot_mode:=simulation \
#          agent_backend:=openai
#
#   5. On Laptop: Open web interface
#      http://localhost:8080
#
#   6. On Laptop: Test with RViz2
#      rviz2
#      # Add displays: PointCloud2 (/robot0/point_cloud2_L1)
#      #                Image (/robot0/front_cam/rgb)
#
# Troubleshooting:
#
#   Q: No topics visible on laptop?
#   A: Check ROS_DOMAIN_ID and ROS_LOCALHOST_ONLY on both machines
#      ping Tower IP to verify network connectivity
#
#   Q: Mission agent can't find topics?
#   A: Remappings are automatic - check that Isaac Sim is publishing
#      ros2 topic hz /robot0/odom  (should show ~50Hz)
#
#   Q: Robot doesn't move in sim?
#   A: Check /robot0/cmd_vel is being published:
#      ros2 topic echo /robot0/cmd_vel
#      Test manually: ros2 topic pub /robot0/cmd_vel geometry_msgs/msg/Twist ...
#
#   Q: DIMOS skills not working?
#   A: This is EXPECTED in simulation mode. WebRTC API not available.
#      Use navigation topics directly (/cmd_vel, /odom)
#
# Topic Namespace:
#   Simulation uses /robot0/* namespace (supports multi-robot)
#   Launch file automatically remaps to mission agent's expected topics
#
# Known Limitations:
#   - WebRTC API unavailable (CONN_TYPE=cyclonedds)
#   - High-level DIMOS skills won't work (sit, stand, wave)
#   - Navigation and perception work perfectly
#
# ============================================================================
