# ============================================================================
# ShadowHound Hardware Environment (Real Unitree Go2)
# ============================================================================
#
# Configuration for production deployment with real robot hardware.
# Copy to .env when deploying to physical robot.
#
# API Keys: Create .env.secrets with your keys (see .env.secrets.example)
#
# ============================================================================

# ----------------------------------------------------------------------------
# Core Configuration
# ----------------------------------------------------------------------------

# API Keys loaded from .env.secrets (gitignored)
# Create: cp .env.secrets.example .env.secrets
# Then edit .env.secrets with your actual OPENAI_API_KEY

# Environment
ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Robot Configuration - HARDWARE MODE
# ----------------------------------------------------------------------------

# Use real robot hardware
ROBOT_MODE=hardware

# Robot IP address - IMPORTANT: Different for Ethernet vs WiFi!
# - CycloneDDS (Ethernet): 192.168.10.167
# - WebRTC (WiFi): Check robot's actual WiFi IP (often different!)
#   To find: Connect to robot WiFi, check router or robot display
ROBOT_IP=192.168.10.167

# ----------------------------------------------------------------------------
# ROS2 Configuration
# ----------------------------------------------------------------------------

# Use standard domain ID (change if conflicts)
ROS_DOMAIN_ID=0

# Use CycloneDDS for better performance
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Connection type for Unitree Go2
# - 'cyclonedds': Ethernet connection, supports /cmd_vel but NO high-level API
# - 'webrtc': WiFi connection, supports DIMOS skills (sit, stand, wave, etc.)
# IMPORTANT: Robot must be on WiFi for webrtc mode!
CONN_TYPE=webrtc

# Standard logging for production
RCUTILS_LOGGING_LEVEL=INFO

# ----------------------------------------------------------------------------
# Agent Configuration - PRODUCTION RECOMMENDED
# ----------------------------------------------------------------------------

# Use OpenAI cloud backend for reliability
AGENT_BACKEND=openai

# OpenAI Production Settings
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# Use planning agent for complex missions
USE_PLANNING_AGENT=false

# Use cloud embeddings (most reliable)
USE_LOCAL_EMBEDDINGS=false

# Production RAG settings
RAG_QUERY_N=5
RAG_SIMILARITY_THRESHOLD=0.6

# ----------------------------------------------------------------------------
# Web Interface - ENABLED
# ----------------------------------------------------------------------------

# Enable web dashboard
ENABLE_WEB_INTERFACE=true

# Standard port
WEB_PORT=8080

# Bind to all interfaces (access from other devices)
WEB_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Logging - PRODUCTION
# ----------------------------------------------------------------------------

# Standard logging
LOG_LEVEL=INFO
DIMOS_DEBUG=false

# Save mission outputs
AGENT_OUTPUT_DIR=./production_output

# ----------------------------------------------------------------------------
# Production Settings
# ----------------------------------------------------------------------------

# Production mode
TEST_MODE=false

# Process all inputs
PROCESS_ALL_INPUTS=true

# ----------------------------------------------------------------------------
# Hardware Setup Instructions
# ----------------------------------------------------------------------------
#
# Prerequisites:
#   1. Unitree Go2 robot powered on
#   2. Robot connected via Ethernet (CycloneDDS) OR WiFi (WebRTC)
#   3. Network connectivity verified (ping ROBOT_IP)
#   4. go2_ros2_sdk driver available
#
# Quick Start (WebRTC Mode - RECOMMENDED):
#   1. Connect robot to WiFi network
#      - Use robot's interface or Unitree app
#      - Note: Robot WiFi IP often different from Ethernet IP!
#
#   2. Update ROBOT_IP above with WiFi IP
#      - Find IP: Check router or robot display
#
#   3. Copy this config
#      cp .env.hardware .env
#      # Edit OPENAI_API_KEY and ROBOT_IP above!
#
#   4. Launch system
#      ./start.sh
#      # System will:
#      #   - Launch robot driver (go2_ros2_sdk)
#      #   - Verify topics are publishing
#      #   - Launch mission agent with DIMOS
#
#   5. Open web interface
#      http://localhost:8080
#
#   6. Test basic command
#      "Stand up" - robot should stand
#      "Sit down" - robot should sit
#      "Wave your paw" - robot should wave
#
# Quick Start (CycloneDDS Mode - Limited):
#   1. Connect robot via Ethernet
#   2. Update config:
#      ROBOT_IP=192.168.10.167  # Ethernet IP
#      CONN_TYPE=cyclonedds
#   3. Launch: ./start.sh
#   4. NOTE: High-level API commands (sit/stand/wave) won't work
#            Only /cmd_vel navigation available
#
# Connection Types Explained:
#
#   WebRTC (Recommended):
#     ✓ Full DIMOS skill library (sit, stand, wave, etc.)
#     ✓ High-level API commands
#     ✓ Better for complex behaviors
#     ✗ Requires WiFi (robot must be on network)
#     ✗ WiFi IP different from Ethernet IP
#
#   CycloneDDS:
#     ✓ Works over Ethernet (more stable)
#     ✓ Direct motor control via /cmd_vel
#     ✓ Good for navigation testing
#     ✗ NO high-level API (no sit/stand/wave)
#     ✗ Limited DIMOS skills available
#
# Troubleshooting:
#
#   Q: Robot not responding?
#   A: 1. Check robot is powered on: ping ROBOT_IP
#      2. Verify CONN_TYPE matches connection (webrtc=WiFi, cyclonedds=Ethernet)
#      3. Check ROBOT_IP is correct for connection type
#      4. Verify topics: ros2 topic list | grep -E '(go2_states|cmd_vel|odom)'
#
#   Q: "Set CONN_TYPE=webrtc to enable DIMOS skills" warning?
#   A: You're in CycloneDDS mode. High-level API unavailable.
#      To fix: Connect robot to WiFi, update ROBOT_IP, set CONN_TYPE=webrtc
#
#   Q: Topics visible but robot doesn't move?
#   A: 1. Check robot is in correct mode (not damping mode)
#      2. Try sport mode on robot controller
#      3. Verify /cmd_vel commands: ros2 topic echo /cmd_vel
#
#   Q: WebRTC connection fails?
#   A: 1. Verify robot on WiFi (not Ethernet)
#      2. Check ROBOT_IP is WiFi IP (not Ethernet IP!)
#      3. Firewall blocking WebRTC ports?
#
# Safety Notes:
#   - Always have emergency stop ready
#   - Start with simple commands (sit, stand)
#   - Test in open area before complex missions
#   - Monitor robot during autonomous operation
#
# ============================================================================
