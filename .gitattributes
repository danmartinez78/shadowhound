# Git attributes for ShadowHound

# Prevent auto-formatting in submodules
src/dimos-unitree/** linguist-vendored
src/dimos-unitree/** -diff

# Ensure consistent line endings
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.launch text eol=lf
*.launch.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.so binary
*.pyc binary
